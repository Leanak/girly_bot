# Copie ce fichier en .env puis remplis les valeurs.
# Le fichier .env est ignoré par git : tes secrets ne partent jamais sur GitHub.

# --- Discord (voir docs/ROADMAP.md, étape 1) ---
DISCORD_TOKEN=colle-ton-token-discord-ici
# Ton identifiant Discord : le bot ne répond qu'à toi
DISCORD_OWNER_ID=123456789012345678

# --- Claude ---
ANTHROPIC_API_KEY=colle-ta-cle-api-ici
CLAUDE_MODEL=claude-opus-5-5

# --- Réglages ---
TIMEZONE=Europe/Paris
# Heure du brief du matin (HH:MM)
MORNING_BRIEF_TIME=07:30
# Plan de la semaine : jour (mon, tue, wed, thu, fri, sat, sun) et heure
WEEKLY_PLAN_DAY=sun
WEEKLY_PLAN_TIME=19:00
# Rappel X minutes avant le début d'une tâche
REMINDER_MINUTES_BEFORE=15
# Fichier de la base SQLite
DATABASE_URL=sqlite:///girlypop.db
