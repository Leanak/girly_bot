# Copie ce fichier en .env puis remplis les valeurs.
# Le fichier .env est ignoré par git : tes secrets ne partent jamais sur GitHub.

# --- Discord (voir docs/ROADMAP.md, étape 1) ---
DISCORD_TOKEN=colle-ton-token-discord-ici
# Ton identifiant Discord : le bot ne répond qu'à toi
DISCORD_OWNER_ID=123456789012345678

# --- Claude ---
ANTHROPIC_API_KEY=colle-ta-cle-api-ici
CLAUDE_MODEL=claude-opus-5-5

# --- Réglages ---
TIMEZONE=Europe/Paris
# Heure du brief du matin (HH:MM)
MORNING_BRIEF_TIME=07:30
# Plan de la semaine : jour (mon, tue, wed, thu, fri, sat, sun) et heure
WEEKLY_PLAN_DAY=sun
WEEKLY_PLAN_TIME=19:00
# Rappel X minutes avant le début d'une tâche
REMINDER_MINUTES_BEFORE=15
# Fichier de la base SQLite
DATABASE_URL=sqlite:///girlypop.db

# --- Rôle Motivatrice ---
# Heures des petits messages de motivation, séparées par des virgules (vide = aucun)
MOTIVATION_TIMES=10:30,14:30,17:00
# Bilan du soir (vide = désactivé)
EVENING_CHECKIN_TIME=21:00
# Message « on passe à la suite ? » à la fin de chaque tâche planifiée (true/false)
TRANSITION_NUDGES=true

# --- Rôle Assistante de temps : calendrier Apple (facultatif, voir docs/ROADMAP.md) ---
# Ton identifiant Apple (l'adresse e-mail)
ICLOUD_USERNAME=
# Un MOT DE PASSE D'APPLICATION (format xxxx-xxxx-xxxx-xxxx), PAS ton vrai mot de passe Apple
ICLOUD_APP_PASSWORD=
# Le calendrier où Girlypop a le droit d'écrire (créé automatiquement s'il n'existe pas)
GIRLYPOP_CALENDAR_NAME=Girlypop
# Calendriers à lire, séparés par des virgules (vide = tous)
READ_CALENDARS=

# --- Google Agenda (ou Outlook...), en lecture seule (facultatif, voir docs/ROADMAP.md) ---
# Une ou plusieurs « adresses secrètes au format iCal », séparées par des virgules, au format Nom|lien
# ex : ICS_CALENDARS=Google perso|https://calendar.google.com/calendar/ical/.../basic.ics,Fac|https://...
ICS_CALENDARS=

# --- Rôle Prof particulière : Notion (facultatif, voir docs/ROADMAP.md) ---
# Le « secret » de ton intégration Notion (commence par ntn_)
NOTION_TOKEN=
# Le lien (ou l'ID) de la page Notion partagée avec l'intégration, où elle range les fiches
NOTION_PARENT_PAGE_ID=
